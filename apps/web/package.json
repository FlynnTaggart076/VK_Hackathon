{
  "name": "vk-zhkh-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:mock": "vite --host 127.0.0.1 --mode mock",
    "dev:real": "vite --host 127.0.0.1 --mode real",
    "build": "tsc -b && vite build",
    "generate:types": "openapi-typescript ../../contracts/http/openapi.yaml -o src/api/openapi.generated.ts",
    "test": "vitest run",
    "test:browser:e2": "node scripts/e2-mock-flow.mjs",
    "test:browser:e2:real": "node scripts/e2-real-flow.mjs",
    "test:browser:e3:mock": "node scripts/e3-mock-flow.mjs",
    "test:browser:e3:real": "node scripts/e3-real-flow.mjs",
    "test:browser:e4:real": "node scripts/e4-real-resilience.mjs",
    "test:browser:e4:clarifications": "node scripts/e4-clarifications-mock.mjs",
    "test:browser:e4:entry-diagnostics": "node scripts/e4-real-entry-diagnostics.mjs",
    "test:browser:e4:synthetic-city-preview-mock": "node scripts/e4-synthetic-city-preview-mock.mjs",
    "test:browser:e4:synthetic-city-preview-live": "node scripts/e4-synthetic-city-preview-live.mjs",
    "test:browser:e4:dense-review": "node scripts/e4-dense-review-mock.mjs",
    "test:browser:e4:bridge-sim": "node scripts/e4-bridge-sim.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
