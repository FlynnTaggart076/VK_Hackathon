    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "knowledge_version": {
      "title": "Knowledge Version",
      "type": "string"
    },
    "receipt_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReceiptRef"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "status",
    "text",
    "topic_id",
    "steps",
    "sources",
    "actions",
    "clarification",
    "limitations",
    "knowledge_version",
    "receipt_ref"
