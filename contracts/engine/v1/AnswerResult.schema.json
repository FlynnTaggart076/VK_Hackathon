          "enum": [
            "topic_id",
            "territory_id",
            "role",
            "organization_id",
            "service_code",
            "document_kind"
          ],
          "title": "Field",
          "type": "string"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/ClarificationOption"
          },
          "title": "Options",
          "type": "array"
        }
      },
      "required": [
        "field",
        "prompt",
        "options"
      ],
      "title": "Clarification",
      "type": "object"
    },
    "ClarificationOption": {
      "additionalProperties": false,
