      "title": "Text",
      "type": "string"
    },
    "topic_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Topic Id"
    },
    "steps": {
      "items": {
        "type": "string"
      },
      "maxItems": 5,
      "title": "Steps",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceRef"
      },
      "title": "Sources",
      "type": "array"
    },
    "actions": {
