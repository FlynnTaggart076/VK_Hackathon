{
  "additionalProperties": false,
  "properties": {
    "path": {
      "pattern": "^/(?:[^~/]|~[01])+(?:/(?:[^~/]|~[01])+)*$",
      "title": "Path",
      "type": "string"
    },
    "source": {
      "enum": [
        "pdf_text",
        "ocr",
        "manual",
        "template_default"
      ],
      "title": "Source",
      "type": "string"
    },
    "page_number": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Page Number"
    },
    "bbox": {
      "anyOf": [
        {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Bbox"
    },
    "source_text": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Text"
    },
    "needs_review": {
      "title": "Needs Review",
      "type": "boolean"
    },
    "reason": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Reason"
    }
  },
  "required": [
    "path",
    "source",
    "page_number",
    "bbox",
    "source_text",
    "needs_review",
    "reason"
  ],
  "title": "FieldEvidence",
  "type": "object"
}
