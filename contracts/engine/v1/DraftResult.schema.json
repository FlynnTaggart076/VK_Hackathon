{
  "$defs": {
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Path"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "path",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "NextAction": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "open_link",
            "prepare_draft",
            "select_topic",
            "navigate"
          ],
          "title": "Type",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "pattern": "^https://[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        },
        "topic_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Topic Id"
        },
        "organization_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Organization Id"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Id"
        },
        "target": {
          "anyOf": [
            {
              "enum": [
                "receipt_upload",
                "receipt_history",
                "receipt_detail",
                "comparison"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target"
        },
        "receipt_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReceiptRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "requires": {
          "items": {
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "label",
        "url",
        "topic_id",
        "organization_id",
        "source_id",
        "target",
        "receipt_ref",
        "requires"
      ],
      "title": "NextAction",
      "type": "object"
    },
    "ReceiptRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "title": "ReceiptRef",
      "type": "object"
    },
    "Recipient": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "Recipient",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "text": {
      "maxLength": 5000,
      "title": "Text",
      "type": "string"
    },
    "recipient": {
      "anyOf": [
        {
          "$ref": "#/$defs/Recipient"
        },
        {
          "type": "null"
        }
      ]
    },
    "actions": {
      "items": {
        "$ref": "#/$defs/NextAction"
      },
      "title": "Actions",
      "type": "array"
    },
    "receipt_refs": {
      "items": {
        "$ref": "#/$defs/ReceiptRef"
      },
      "title": "Receipt Refs",
      "type": "array"
    },
    "knowledge_version": {
      "title": "Knowledge Version",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    }
  },
  "required": [
    "text",
    "recipient",
    "actions",
    "receipt_refs",
    "knowledge_version",
    "issues"
  ],
  "title": "DraftResult",
  "type": "object"
}
