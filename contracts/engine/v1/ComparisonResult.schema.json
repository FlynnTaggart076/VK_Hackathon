{
  "$defs": {
    "ComparedLine": {
      "additionalProperties": false,
      "properties": {
        "older_line_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Older Line Id"
        },
        "newer_line_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Newer Line Id"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "match_status": {
          "enum": [
            "matched",
            "added",
            "removed",
            "ambiguous",
            "incompatible"
          ],
          "title": "Match Status",
          "type": "string"
        },
        "older_amount": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]{0,8})\\.[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Older Amount"
        },
        "newer_amount": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]{0,8})\\.[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Newer Amount"
        },
        "delta": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]{0,8})\\.[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Delta"
        },
        "quantity_effect": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]{0,8})\\.[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Quantity Effect"
        },
        "tariff_effect": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]{0,8})\\.[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tariff Effect"
        },
        "rounding_effect": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]{0,8})\\.[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rounding Effect"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "older_line_id",
        "newer_line_id",
        "label",
        "match_status",
        "older_amount",
        "newer_amount",
        "delta",
        "quantity_effect",
        "tariff_effect",
        "rounding_effect",
        "explanation"
      ],
      "title": "ComparedLine",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Path"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "path",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    },
    "NextAction": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "open_link",
            "prepare_draft",
            "select_topic",
            "navigate"
          ],
          "title": "Type",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "pattern": "^https://[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Url"
        },
        "topic_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Topic Id"
        },
        "organization_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Organization Id"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Id"
        },
        "target": {
          "anyOf": [
            {
              "enum": [
                "receipt_upload",
                "receipt_history",
                "receipt_detail",
                "comparison"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target"
        },
        "receipt_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReceiptRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "requires": {
          "items": {
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "label",
        "url",
        "topic_id",
        "organization_id",
        "source_id",
        "target",
        "receipt_ref",
        "requires"
      ],
      "title": "NextAction",
      "type": "object"
    },
    "PeriodReceiptRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "period": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Period"
        }
      },
      "required": [
        "id",
        "revision",
        "period"
      ],
      "title": "PeriodReceiptRef",
      "type": "object"
    },
    "ReceiptRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "title": "ReceiptRef",
      "type": "object"
    },
    "SettlementDelta": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "opening_balance",
            "payments_credited",
            "penalties",
            "other_account_changes",
            "credit_clamp"
          ],
          "title": "Code",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "raw_delta": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]{0,8})\\.[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Raw Delta"
        },
        "contribution": {
          "anyOf": [
            {
              "pattern": "^-?(?:0|[1-9][0-9]{0,8})\\.[0-9]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Contribution"
        }
      },
      "required": [
        "code",
        "label",
        "raw_delta",
        "contribution"
      ],
      "title": "SettlementDelta",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "complete",
        "partial",
        "needs_identity_confirmation"
      ],
      "title": "Status",
      "type": "string"
    },
    "older": {
      "$ref": "#/$defs/PeriodReceiptRef"
    },
    "newer": {
      "$ref": "#/$defs/PeriodReceiptRef"
    },
    "engine_version": {
      "title": "Engine Version",
      "type": "string"
    },
    "knowledge_version": {
      "title": "Knowledge Version",
      "type": "string"
    },
    "delta_current_charges": {
      "anyOf": [
        {
          "pattern": "^-?(?:0|[1-9][0-9]{0,8})\\.[0-9]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Delta Current Charges"
    },
    "delta_adjustments": {
      "anyOf": [
        {
          "pattern": "^-?(?:0|[1-9][0-9]{0,8})\\.[0-9]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Delta Adjustments"
    },
    "delta_total_due": {
      "anyOf": [
        {
          "pattern": "^-?(?:0|[1-9][0-9]{0,8})\\.[0-9]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Delta Total Due"
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/ComparedLine"
      },
      "title": "Lines",
      "type": "array"
    },
    "settlement_deltas": {
      "items": {
        "$ref": "#/$defs/SettlementDelta"
      },
      "title": "Settlement Deltas",
      "type": "array"
    },
    "unexplained_delta": {
      "anyOf": [
        {
          "pattern": "^-?(?:0|[1-9][0-9]{0,8})\\.[0-9]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Unexplained Delta"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    },
    "actions": {
      "items": {
        "$ref": "#/$defs/NextAction"
      },
      "title": "Actions",
      "type": "array"
    }
  },
  "required": [
    "status",
    "older",
    "newer",
    "engine_version",
    "knowledge_version",
    "delta_current_charges",
    "delta_adjustments",
    "delta_total_due",
    "lines",
    "settlement_deltas",
    "unexplained_delta",
    "issues",
    "actions"
  ],
  "title": "ComparisonResult",
  "type": "object"
}
