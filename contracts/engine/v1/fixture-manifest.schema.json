{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "samples"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "samples": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "sha256", "bytes", "media_type", "representation", "template_id", "expected_fields", "origin", "is_synthetic"],
      "properties": {
        "file": {"type": "string", "pattern": "^[^/\\\\]+$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "media_type": {"enum": ["application/pdf", "image/png", "image/jpeg", "application/json"]},
        "representation": {"type": "string", "minLength": 1},
        "template_id": {"type": ["string", "null"]},
        "expected_fields": {"type": "object"},
        "origin": {"type": "string", "minLength": 1},
        "is_synthetic": {"const": true}
      }
    }}
  }
}
