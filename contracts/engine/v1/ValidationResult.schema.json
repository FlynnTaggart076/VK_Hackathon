{
  "$defs": {
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Severity",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Path"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "path",
        "message"
      ],
      "title": "Issue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "can_confirm": {
      "title": "Can Confirm",
      "type": "boolean"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Errors",
      "type": "array"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Warnings",
      "type": "array"
    },
    "reconciliation_status": {
      "enum": [
        "matched",
        "mismatch",
        "incomplete",
        "unsupported"
      ],
      "title": "Reconciliation Status",
      "type": "string"
    }
  },
  "required": [
    "can_confirm",
    "errors",
    "warnings",
    "reconciliation_status"
  ],
  "title": "ValidationResult",
  "type": "object"
}
