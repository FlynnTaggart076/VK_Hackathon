# Copy to an untracked .env and set unique local secrets before Compose startup.
APP_MODE=dev
ENGINE_MODE=real
DEMO_AUTH_ENABLED=true
DEMO_ACCESS_CODE=replace-with-private-random-code
POSTGRES_PASSWORD=replace-with-private-random-password
LOCAL_WEB_PORT=8080
# Leave MAX integration disabled until real credentials are placed in private .env.
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_WEB_APP=
MAX_API_BASE_URL=https://platform-api2.max.ru
