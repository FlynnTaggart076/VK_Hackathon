# Copy to an untracked .env and set unique local secrets before Compose startup.
APP_MODE=dev
ENGINE_MODE=real
DEMO_AUTH_ENABLED=true
# Dev demo auth only; compose.vm.yaml forces demo auth off and ignores this value.
DEMO_ACCESS_CODE=replace-with-private-random-code
POSTGRES_PASSWORD=replace-with-private-random-password
LOCAL_WEB_PORT=8080
# For VM, put real values only in ../runtime/app.env outside the deploy checkout.
# compose.vm.yaml requires all three MAX fields and forces production mode.
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
MAX_WEB_APP=
MAX_API_BASE_URL=https://platform-api2.max.ru
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# The isolated browser preview uses compose.preview.vm.yaml, which forces
# APP_MODE=preview, PREVIEW_AUTH_ENABLED=true and all MAX credentials blank.
# Give it a separate private runtime env with a distinct POSTGRES_PASSWORD.
